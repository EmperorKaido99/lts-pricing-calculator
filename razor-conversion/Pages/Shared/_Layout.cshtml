@*
    REFERENCE _Layout.cshtml — based on the DEFAULT ASP.NET Core 6 Razor
    Pages template (`dotnet new webapp`).

    ==========================================================================
    IMPORTANT: this is a reference file, not a guaranteed drop-in replacement.
    If your real Pages/Shared/_Layout.cshtml already exists and differs from
    the default template (different branding, extra nav items, a different
    CSS/JS bundle, etc.), do NOT overwrite it with this file — instead, merge
    in just the three things marked "ADDED FOR THE CALCULATOR" below:

      1. `@RenderSection("Styles", required: false)` in <head>, so
         Index.cshtml's `@section Styles { ... }` (the calculator's
         stylesheet) actually gets rendered.
      2. The navbar wrapped in `@if (ViewData["HideNav"] as bool? != true)`,
         so the calculator page (which sets ViewData["HideNav"] = true in
         Index.cshtml) can hide the shared nav and show its own top bar
         instead. Every other page keeps the nav as normal.
      3. The Bootstrap `.container` wrapper around @RenderBody() made
         conditional on `ViewData["FullBleed"]`. The calculator's topbar,
         hero banner and footer are all designed edge-to-edge (full viewport
         width) — if left inside `.container` (which caps width and adds
         side margins/padding), the hero gradient and topbar would visibly
         NOT span the full page, breaking the "pixel-perfect" requirement.
         Every other page is unaffected — ViewData["FullBleed"] is unset
         (null) for them, so they keep the normal contained layout.

    The `@RenderSectionAsync("Scripts", required: false)` near </body> is
    part of the *default* template already — if your real layout has it,
    you don't need to add anything else for Index.cshtml's Scripts section
    to work.
    ==========================================================================
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RazorApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/RazorApp.styles.css" />

    @* ---- ADDED FOR THE CALCULATOR (1 of 2): lets a page pull in its own
         page-specific stylesheet via @section Styles { ... }. Harmless for
         every other page — required:false means it's a no-op if unused. ---- *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        @* ---- ADDED FOR THE CALCULATOR (2 of 2): the calculator page sets
             ViewData["HideNav"] = true and renders its own <header> top bar,
             so the shared navbar below is skipped for that page only. Every
             other page is unaffected — ViewData["HideNav"] is unset (null)
             for them, so the nav renders exactly as before. ---- *@
        @if (ViewData["HideNav"] as bool? != true)
        {
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">RazorApp</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }
    </header>

    @* ---- ADDED FOR THE CALCULATOR (3 of 3): skip the Bootstrap .container
         wrapper for pages that render their own full-width layout. ---- *@
    @if (ViewData["FullBleed"] as bool? == true)
    {
        @RenderBody()
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RazorApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Already part of the default template — Index.cshtml's
       @section Scripts { ... } (SheetJS + pricing-calculator.js) renders
       here, after the shared site scripts. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
